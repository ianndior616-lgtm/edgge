# PostgreSQL. DATABASE_URL is preferred.
# Vercel Postgres/Neon projects may provide POSTGRES_URL automatically instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Telegram production configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
APP_URL=https://your-project.vercel.app
TELEGRAM_WEBHOOK_SECRET=

# Optional administration and integrations
ADMIN_TG_IDS=
ADMIN_ACCESS_CODE=
BOT_SETUP_SECRET=
STEAM_WEB_API_KEY=
OPENDOTA_API_KEY=
VIP_STARS_PRICE=150
